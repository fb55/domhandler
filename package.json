{
    "name": "domhandler",
    "version": "6.0.1",
    "description": "Handler for htmlparser2 that turns pages into a dom",
    "keywords": [
        "dom",
        "htmlparser2"
    ],
    "license": "BSD-2-Clause",
    "author": "Felix Boehm <me@feedic.com>",
    "repository": {
        "type": "git",
        "url": "git://github.com/fb55/domhandler.git"
    },
    "funding": {
        "type": "github",
        "url": "https://github.com/fb55/domhandler?sponsor=1"
    },
    "files": [
        "dist",
        "src",
        "!**/*.spec.ts"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "build:docs": "typedoc --hideGenerator --plugin typedoc-plugin-missing-exports src/index.ts",
        "format": "npm run lint:ox -- --fix && npm run format:ox",
        "format:ox": "node --import=tsx node_modules/oxfmt/bin/oxfmt \"**/*.{ts,md,json,yml}\"",
        "lint": "npm run lint:ox && tsc && npm run format:ox -- --check",
        "lint:ox": "node --import=tsx node_modules/oxlint/bin/oxlint",
        "prepublishOnly": "npm run build",
        "test": "npm run test:vi && npm run lint",
        "test:vi": "vitest run"
    },
    "dependencies": {
        "domelementtype": "^3.0.0"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "htmlparser2": "^12.0.0",
        "oxfmt": "^0.79.0",
        "oxlint": "^1.94.0",
        "oxlint-tsgolint": "^7.0.2008",
        "tsx": "^4.23.15",
        "typedoc": "^0.28.20",
        "typedoc-plugin-missing-exports": "^4.1.4",
        "typescript": "^6.0.3",
        "vitest": "^5.1.0"
    },
    "engines": {
        "node": ">=20.19.0"
    }
}
